{
  "manifest_version": 3,
  "name": "Ambient — Minimal New Tab",
  "short_name": "Ambient",
  "version": "1.0.0",
  "description": "A minimal glass-style new tab page: clock, date, search, and custom shortcuts.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "favicon", "search"]
}
